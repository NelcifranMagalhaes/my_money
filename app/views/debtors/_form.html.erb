<%= form_with(model: debtor) do |form| %>
  <% if debtor.errors.any? %>
    <div style="color: red">
      <ul>
        <% debtor.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= form.label :name, class: "form-label", for: "debtorName" %>
    <%= form.text_field :name, class: "form-control", id: "debtorName", placeholder: "nome do devedor", required: true %>
  </div>
  <div class="mb-3">
    <%= form.submit "Enviar", class: "btn btn-success" %>
  </div>

<% end %>
