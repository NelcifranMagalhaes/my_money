<% if notice.present? %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<% content_for :title, "Despesas" %>

<h1>Despesas</h1>
<div class="mb-4">
  <%= search_form_for @q do |f| %>

    <%= f.label :label_or_description_cont, "Descrição Ou Nome", class: "form-label" %>
    <%= f.search_field :label_or_description_cont, class: "form-control" %>

    <div class="row mt-2">
      <div class="col-md-6">
        <%= f.label :money_date_gteq, "Data Inicial", class: "form-label" %>
        <%= f.search_field :money_date_gteq, type: :date, class: "form-control" %>
      </div>
      <div class="col-md-6">
        <%= f.label :money_date_lteq, "Data Final", class: "form-label" %>
        <%= f.search_field :money_date_lteq, type: :date, class: "form-control" %>
      </div>
    </div>

    <%= f.label :category_id_eq, "Categoria", class: "form-label" %>
    <%= f.select :category_id_eq, options_from_collection_for_select(@categories, :id, :name, params.dig(:q, :category_id_eq)), { include_blank: "Todas" }, class: "form-select" %>

    <div class="row mt-2">
      <div class="col-md-6">
        <%= f.label :amount_gteq, "Valor Mínimo", class: "form-label" %>
        <%= f.search_field :amount_gteq, type: :number, step: :any, class: "form-control" %>
      </div>
      <div class="col-md-6">
        <%= f.label :amount_lteq, "Valor Máximo", class: "form-label" %>
        <%= f.search_field :amount_lteq, type: :number, step: :any, class: "form-control" %>
      </div>
    </div>

    <%= f.submit "Buscar", class: "btn btn-primary mt-2" %>
  <% end %>
  
  <div class="row mt-2">
    <div class="col-md-6">
      <% selected_base_date = (@q.money_date_gteq.presence || @q.money_date_lteq.presence || Date.current).to_date %>
      <% prev_month_start = selected_base_date.prev_month.beginning_of_month %>
      <% prev_month_end = selected_base_date.prev_month.end_of_month %>
      <div class="d-flex justify-content-center">
        <%= link_to "Mês Anterior", money_outs_path(q: { money_date_gteq: prev_month_start, money_date_lteq: prev_month_end }), class: "btn btn-secondary mt-2" %>
      </div>
    </div>
    <div class="col-md-6">
      <% selected_base_date = (@q.money_date_gteq.presence || @q.money_date_lteq.presence || Date.current).to_date %>
      <% next_month_start = selected_base_date.next_month.beginning_of_month %>
      <% next_month_end = selected_base_date.next_month.end_of_month %>
      <div class="d-flex justify-content-center">
        <%= link_to "Próximo Mês", money_outs_path(q: { money_date_gteq: next_month_start, money_date_lteq: next_month_end }), class: "btn btn-secondary mt-2" %>
      </div>
    </div>
  </div>

</div>
<div class="d-flex justify-content-end mb-3">
  <span class="badge text-bg-info fs-5 fw-semibold"><%= number_to_currency(@total_amount) %></span>
</div>

<div id="money_outs">
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Descrição</th>
        <th>Valor</th>
        <th>Data</th>
        <th>Categoria</th>
        <th>Parcela</th>
        <th>Ações</th>
      </tr>
    </thead>

    <tbody>
      <% @money_outs.each do |money_out| %>
        <tr>
          <td><%= money_out.label %></td>
          <td><%= money_out.description.truncate(50) %></td>
          <td><%= number_to_currency(money_out.amount) %></td>
          <td><%= money_out.money_date.strftime("%d/%m/%Y") %></td>
          <td><%= money_out.category.name if money_out.category %></td>
          <td>
            <%= installment_badge(money_out) %>
          </td>
          <td>
            <div class="d-grid gap-2 d-md-flex">
              <%= link_to "Editar", edit_money_out_path(money_out), class: "btn btn-warning" %>
              <%= link_to "Excluir", money_out, data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "btn btn-danger" %>
              <%= link_to(money_out , class: "btn btn-default") do %>
                <i class="fa-solid fa-eye"></i> Ver
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%== @pagy.series_nav(:bootstrap) %>
<div class="pb-5 mb-3 d-md-none"></div>

<div class="position-fixed bottom-0 start-50 translate-middle-x p-3 d-md-none" style="z-index: 1030;">
  <%= link_to "Nova Despesa", new_money_out_path, class: "btn btn-primary btn-sm px-4 rounded-pill shadow" %>
</div>

<%= link_to "Nova Despesa", new_money_out_path, class: "btn btn-primary position-fixed bottom-0 end-0 m-4 d-none d-md-inline-flex shadow", style: "z-index: 1030;" %>

